<%- include("partials/header") %>

<div class="mb-8">
  <h1 class="page-title">Namaste, <%= currentUser.name %></h1>
  <p class="mt-1 muted">Here is how your farm looks today.</p>
</div>

<!-- Totals -->
<section class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <%
    const stats = [
      { icon: "i-crop",    label: "Total crops",       value: totalCrops,              unit: "" },
      { icon: "i-ruler",    label: "Land under use",    value: totalLandArea,           unit: "acre" },
      { icon: "i-sprout",   label: "Currently growing", value: statusCounts["Growing"], unit: "" },
      { icon: "i-calendar", label: "Harvest in 30 days", value: upcomingHarvests.length, unit: "" }
    ];
  %>
  <% stats.forEach(function (stat) { %>
    <div class="card p-5 hover:-translate-y-0.5 hover:shadow-lift">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-sm muted"><%= stat.label %></p>
          <p class="mt-1 text-3xl font-bold">
            <%= stat.value %><% if (stat.unit) { %>
              <span class="text-base font-medium muted"><%= stat.unit %></span>
            <% } %>
          </p>
        </div>
        <span class="grid h-10 w-10 place-items-center rounded-xl bg-leaf-100 text-leaf-700 dark:bg-night-700 dark:text-leaf-400">
          <svg class="icon"><use href="#<%= stat.icon %>" /></svg>
        </span>
      </div>
    </div>
  <% }); %>
</section>

<div class="grid gap-6 lg:grid-cols-3">

  <!-- Crops by status -->
  <section class="card p-6">
    <h2 class="section-title">Crops by status</h2>
    <p class="text-sm muted">Click a status to see those crops.</p>

    <div class="mt-4 space-y-2">
      <% statuses.forEach(function (status) { %>
        <%
          const count = statusCounts[status];
          const percent = totalCrops > 0 ? Math.round((count / totalCrops) * 100) : 0;
        %>
        <a href="/crops?status=<%= status %>"
          class="block rounded-xl p-2 transition hover:bg-leaf-50 dark:hover:bg-night-700">
          <div class="flex items-center justify-between text-sm">
            <span class="font-medium"><%= status %></span>
            <span class="muted"><%= count %></span>
          </div>
          <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-leaf-100 dark:bg-night-600">
            <div class="h-full rounded-full bg-leaf-500 transition-all duration-500" style="width: <%= percent %>%"></div>
          </div>
        </a>
      <% }); %>
    </div>
  </section>

  <!-- Upcoming harvests -->
  <section class="card p-6 lg:col-span-2">
    <h2 class="section-title">Upcoming harvests</h2>
    <p class="text-sm muted">Crops due to be harvested in the next 30 days.</p>

    <% if (upcomingHarvests.length === 0) { %>
      <div class="empty mt-5">
        <svg class="icon icon-xl mx-auto text-leaf-400 dark:text-night-400"><use href="#i-calendar" /></svg>
        <p class="mt-3 font-medium">No harvest is due in the next 30 days</p>
        <p class="mt-1 text-sm muted">Crops appear here once their expected harvest date comes close.</p>
      </div>
    <% } else { %>
      <ul class="mt-4 row-list">
        <% upcomingHarvests.forEach(function (crop) { %>
          <% const daysLeft = Math.ceil((crop.expectedHarvestDate - new Date()) / (1000 * 60 * 60 * 24)); %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="flex items-center gap-3">
              <span class="grid h-9 w-9 place-items-center rounded-lg bg-leaf-100 text-leaf-700 dark:bg-night-700 dark:text-leaf-400">
                <svg class="icon"><use href="#i-crop" /></svg>
              </span>
              <div>
                <a href="/crops/<%= crop._id %>" class="font-medium hover:underline"><%= crop.name %></a>
                <p class="text-sm muted">
                  <%= crop.landArea %> acre &middot; <%= crop.expectedHarvestDate.toLocaleDateString("en-IN") %>
                </p>
              </div>
            </div>
            <div class="text-right">
              <%- include("partials/status-badge", { status: crop.status }) %>
              <p class="mt-1 text-xs muted"><%= daysLeft %> day<%= daysLeft === 1 ? "" : "s" %> left</p>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

</div>

<!-- Recent activity -->
<section class="mt-6 card p-6">
  <h2 class="section-title">Recent farming activity</h2>

  <% if (recentActivities.length === 0) { %>
    <div class="empty mt-5">
      <svg class="icon icon-xl mx-auto text-leaf-400 dark:text-night-400"><use href="#i-clipboard" /></svg>
      <p class="mt-3 font-medium">Nothing logged yet</p>
      <p class="mt-1 text-sm muted">Open a crop to record irrigation, fertilizer or pest control.</p>
      <a href="/crops" class="btn-ghost mt-5">Go to my crops</a>
    </div>
  <% } else { %>
    <%
      const activityIcons = {
        "Irrigation": "i-droplet",
        "Fertilizer": "i-flask",
        "Pest Control": "i-bug"
      };
    %>
    <ul class="mt-4 row-list">
      <% recentActivities.forEach(function (activity) { %>
        <li class="flex items-center justify-between gap-4 py-3 text-sm">
          <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-leaf-100 text-leaf-700 dark:bg-night-700 dark:text-leaf-400">
              <svg class="icon"><use href="#<%= activityIcons[activity.type] %>" /></svg>
            </span>
            <div>
              <span class="font-medium"><%= activity.type %></span>
              <p class="muted">
                on <a href="/crops/<%= activity.crop._id %>" class="underline underline-offset-2"><%= activity.crop.name %></a>
              </p>
            </div>
          </div>
          <div class="text-right muted">
            <span><%= activity.date.toLocaleDateString("en-IN") %></span>
            <% if (activity.cost > 0) { %>
              <p class="font-semibold text-leaf-800 dark:text-leaf-300">&#8377;<%= activity.cost %></p>
            <% } %>
          </div>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>

<%- include("partials/footer") %>
