<%
  const statusColors = {
    Planned:   "bg-slate-100 text-slate-700 ring-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:ring-slate-600",
    Sown:      "bg-amber-100 text-amber-800 ring-amber-300 dark:bg-amber-950 dark:text-amber-200 dark:ring-amber-800",
    Growing:   "bg-leaf-100 text-leaf-800 ring-leaf-300 dark:bg-leaf-900 dark:text-leaf-100 dark:ring-leaf-700",
    Harvested: "bg-sky-100 text-sky-800 ring-sky-300 dark:bg-sky-950 dark:text-sky-200 dark:ring-sky-800",
    Failed:    "bg-red-100 text-red-800 ring-red-300 dark:bg-red-950 dark:text-red-200 dark:ring-red-800"
  };
%>
<span class="badge <%= statusColors[status] %>"><%= status %></span>
