  </main>

  <footer class="mt-12 border-t border-leaf-200 bg-white dark:border-night-600 dark:bg-night-800 print:hidden">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-2 px-4 py-6 text-sm muted">
      <svg class="icon"><use href="#i-sprout" /></svg>
      <span>Smart Crop Management System &mdash; Web Development Project</span>
    </div>
  </footer>

  <script>
    // theme switch, remembered in the browser
    document.getElementById("themeToggle").addEventListener("click", function () {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (e) {
        // nothing to do if saving is blocked
      }
    });
  </script>

</body>
</html>
